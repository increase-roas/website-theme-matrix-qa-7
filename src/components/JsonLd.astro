---
/**
 * Renders one JSON-LD block. Kept trivial on purpose: the SHAPE of the data
 * is decided in src/lib/seo.ts, so a page can never assemble its own,
 * slightly different, description of the same business.
 */
interface Props {
  data: Record<string, unknown> | null;
}
const { data } = Astro.props;
---

{data && <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />}
