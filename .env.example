# Copy to .env for local dev. NEVER commit .env.
# In production these are set with `wrangler secret put NAME`.

# --- Admin (Phase 6 — reuses the existing Sun Pool auth pattern as-is) ---
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- R2 public image host ---
R2_PUBLIC_BUCKET_ID=
R2_PUBLIC_BASE_URL=

# --- GoHighLevel (Phase 8) ---
GHL_API_KEY=
GHL_LOCATION_ID=

# --- Meta Pixel + CAPI (Phase 8) ---
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# --- Monitoring ---
PUBLIC_SENTRY_DSN=

# NOTE: brand colours, logo URLs, phone, address, hours, nav and categories
# are NOT environment variables. They live in src/config/client.config.ts.
